    "markdownImageText": {
      "dark": "vhPink",
      "light": "vhPink"
    },
    "markdownCodeBlock": {
      "dark": "vhForeground",
      "light": "vhForeground"
    },
    "syntaxComment": {
      "dark": "vhComment",
      "light": "vhComment"
    },
    "syntaxKeyword": {
      "dark": "vhPink",
      "light": "vhPink"
    },
    "syntaxFunction": {
      "dark": "vhGreen",
      "light": "vhGreen"
    },
    "syntaxVariable": {
      "dark": "vhForeground",
      "light": "vhForeground"
    },
    "syntaxString": {
      "dark": "vhYellow",
      "light": "vhYellow"
    },
    "syntaxNumber": {
      "dark": "vhPurple",
      "light": "vhPurple"
    },
    "syntaxType": {
      "dark": "vhCyan",
      "light": "vhCyan"
    },
    "syntaxOperator": {
      "dark": "vhPink",
      "light": "vhPink"
    },
    "syntaxPunctuation": {
      "dark": "vhForeground",
      "light": "vhForeground"
    },
    "inputBackground": {
      "dark": "vhBg",
      "light": "vhBg"
    },
    "InputBorder": {
      "dark": "vhBorder",
      "light": "vhBorder"
    },
    "InputBorderActive": {
      "dark": "vhAccent",
      "light": "vhAccent"
    },
    "inputPrompt": {
      "dark": "vhCyan",
      "light": "vhCyan"
    },
    "inputCursor": {
      "dark": "vhPurple",
      "light": "vhPurple"
    },
    "inputText": {
      "dark": "vhForeground",
      "light": "vhForeground"
    }
