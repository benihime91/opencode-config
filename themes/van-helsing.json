      "dark": "vhCyan",
      "light": "vhCyan"
    },
    "secondary": {
      "dark": "vhPurple",
      "light": "vhPurple"
    },
    "accent": {
      "dark": "vhAccent",
      "light": "vhAccent"
    },
    "error": {
      "dark": "vhError",
      "light": "vhError"
    },
    "warning": {
      "dark": "vhWarning",
      "light": "vhWarning"
    },
    "success": {
      "dark": "vhSuccess",
      "light": "vhSuccess"
    },
    "info": {
      "dark": "vhInfo",
      "light": "vhInfo"
    },
    "text": {
      "dark": "vhForeground",
      "light": "vhForeground"
    },
    "textMuted": {
      "dark": "vhMuted",
      "light": "vhMuted"
    },
    "background": {
      "dark": "vhBg",
      "light": "vhBg"
    },
    "backgroundPanel": {
      "dark": "vhPanel",
      "light": "vhPanel"
    },
    "backgroundElement": {
      "dark": "vhElevated",
      "light": "vhElevated"
    },
    "border": {
      "dark": "vhBorder",
      "light": "vhBorder"
    },
    "borderActive": {
      "dark": "vhAccent",
      "light": "vhAccent"
    },
    "borderSubtle": {
