    "diffHunkHeader": {
      "dark": "vhMuted",
      "light": "vhMuted"
    },
    "diffHighlightAdded": {
      "dark": "vhGreen",
      "light": "vhGreen"
    },
    "diffHighlightRemoved": {
      "dark": "vhRed",
      "light": "vhRed"
