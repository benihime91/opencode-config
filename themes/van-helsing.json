    "markdownLinkText": {
      "dark": "vhPink",
      "light": "vhPink"
    },
    "markdownCode": {
      "dark": "vhGreen",
      "light": "vhGreen"
    },
    "markdownBlockQuote": {
      "dark": "vhComment",
      "light": "vhComment"
