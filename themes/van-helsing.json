{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "vhBg": "#0b0d0f",
    "vhSurface": "#0a0c0e",
    "vhPanel": "#151c1b",
    "vhElevated": "#1d2625",
    "vhBorder": "#394d49",
    "vhAccent": "#BFFFF4",
    "vhForeground": "#f8f8f2",
    "vhMuted": "#708ca9",
    "vhPurple": "#9580ff",
    "vhPink": "#ff80bf",
    "vhCyan": "#80ffea",
    "vhGreen": "#8aff80",
    "vhOrange": "#ffca80",
    "vhYellow": "#ffff80",
    "vhRed": "#ff9580",
    "vhError": "#e67070",
    "vhWarning": "#e6e370",
    "vhSuccess": "#7de972",
    "vhInfo": "#75ece0",
    "vhComment": "#708ca9",
    "vhSelection": "#9580ff33",
    "vhHighlight": "#414d58",
    "vhDimWhite": "#c6c6c2"
