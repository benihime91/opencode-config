{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "permission": {
    "question": "allow",
    "websearch": "allow",
    "lsp": "allow"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@tarquinen/opencode-dcp@latest"
  ],
  "agent": {
    "hermes": {
      "color": "#14B8A6"
    },
    "zeus": {
      "color": "#D4A017"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": [
        "uvx ty server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  }
}
