{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "permission": {
    "question": "allow",
    "websearch": "allow",
    "lsp": "allow"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@tarquinen/opencode-dcp@latest"
  ],
  "agent": {
    "urahara": {
      "color": "#3F5A4B"
    },
    "shikamaru": {
      "color": "#4B3B63"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": [
        "bunx",
        "firecrawl-mcp"
      ],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_URL": "${FIRECRAWL_API_URL:-http://localhost:3002}",
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-}"
      }
    },
    "agentation": {
      "type": "local",
      "command": [
        "bunx",
        "agentation-mcp",
        "server"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "bunx",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa,company_research_exa,people_search_exa",
      "enabled": true
    }
  },
  "formatter": {
    "ruff": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "lsp": {
    "ty": {
      "command": [
        "uvx",
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "ruff": {
      "command": [
        "uvx",
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "pyright": {
      "disabled": true
    }
  }
}
