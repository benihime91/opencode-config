{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "permission": {
    "question": "allow",
    "websearch": "allow",
    "lsp": "allow"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@tarquinen/opencode-dcp@latest"
  ],
  "agent": {
    "neo": {
      "color": "#3F5A4B"
    },
    "morpheus": {
      "color": "#4B3B63"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "mcp": {
    "contextplus": {
      "type": "local",
      "timeout": 300000,
      "command": [
        "npx",
        "-y",
        "contextplus"
      ],
      "enabled": true,
      "environment": {
        "OLLAMA_EMBED_MODEL": "nomic-embed-text-v2-moe:latest"
      }
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": [
        "uvx ty server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  }
}
