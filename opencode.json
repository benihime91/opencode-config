{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "permission": {
    "question": "allow",
    "websearch": "allow",
    "lsp": "allow"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3"
  ],
  "agent": {
    "urahara": {
      "color": "#3F5A4B"
    },
    "trip-planner": {
      "color": "#E07C24"
    }
  },
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": [
        "bunx",
        "firecrawl-mcp"
      ],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_URL": "http://localhost:3002",
        "FIRECRAWL_API_KEY": "fc-local"
      }
    },
    "agentation": {
      "type": "local",
      "command": [
        "bunx",
        "agentation-mcp",
        "server"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "bunx",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa,company_research_exa,people_search_exa",
      "enabled": true
    }
  },
  "formatter": {
    "ruff": {
      "command": [
        "ruff",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "lsp": {
    "ty": {
      "command": [
        "uvx",
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "ruff": {
      "command": [
        "uvx",
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "pyright": {
      "disabled": true
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**"
    ]
  }
}