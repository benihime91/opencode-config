{
  // Default: deny all skills unless an agent entry allowlists them (pairs with plugins/agent-permissions.ts + using-skills.ts).
  "defaults": {
    "skills": [
      "!*"
    ]
  },
  "agents": {
    // ─── Primary agents — full skill access ───
    "shikamaru": {
      "skills": [
        "*"
      ]
    },
    "urahara": {
      "skills": [
        "*"
      ]
    },
    // ─── Built-in agents — everything except planning-file ownership ───
    // Note: this repo's opencode.json disables `general` and `explore`; keep entries for forks or other installs.
    "build": {
      "skills": [
        "*",
        "!planning-with-files"
      ]
    },
    "general": {
      "skills": [
        "*",
        "!planning-with-files"
      ]
    },
    "plan": {
      "skills": [
        "*",
        "!planning-with-files"
      ]
    },
    // ─── Hinata — The Explorer (Haikyuu) ───
    // Read-only codebase scout. Lean and fast.
    "hinata": {
      "skills": [
        "repo-discovery",
        "semctx",
        "agent-browser",
        "simplify"
      ]
    },
    // ─── Gojo — The Oracle (JJK) ───
    // Architect + strategic advisor. Needs design, research, and planning skills.
    "gojo": {
      "skills": [
        "agent-harness-construction",
        "brainstorming",
        "repo-discovery",
        "semctx",
        "research",
        "firecrawl",
        "writing-plans",
        "agent-browser",
        "simplify",
        "modular-code-enforcement",
        "python-coding-style"
      ]
    },
    // ─── Kenma — The Librarian (Haikyuu) ───
    // Research + documentation. Covers external evidence and doc authorship.
    "kenma": {
      "skills": [
        "repo-discovery",
        "semctx",
        "research",
        "firecrawl",
        "article-writing",
        "writing-clearly-and-concisely",
        "writing-plans",
        "writing-skills",
        "agent-browser",
        "simplify"
      ]
    },
    // ─── Oikawa — The Designer (Haikyuu) ───
    // UI/UX specialist. Design skills + QA/testing + design research.
    "oikawa": {
      "skills": [
        "brainstorming",
        "repo-discovery",
        "semctx",
        "planning-with-files",
        "research",
        "firecrawl",
        "frontend-design",
        "frontend-patterns",
        "frontend-slides",
        "liquid-glass-design",
        "agentation",
        "annotation-sync",
        "agentation-self-driving",
        "dogfood",
        "agent-browser",
        "writing-clearly-and-concisely",
        "simplify",
        "modular-code-enforcement"
      ]
    },
    // ─── Nanami — The Fixer (JJK) ───
    // Execution specialist. Implementation, review, refactoring, QA.
    "nanami": {
      "skills": [
        "repo-discovery",
        "semctx",
        "executing-plans",
        "dogfood",
        "writing-clearly-and-concisely",
        "simplify",
        "agent-browser",
        "modular-code-enforcement",
        "python-coding-style",
        "frontend-design",
        "frontend-patterns",
        "frontend-slides",
        "liquid-glass-design"
      ]
    }
  }
}
